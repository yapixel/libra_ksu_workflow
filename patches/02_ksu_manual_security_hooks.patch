+
 	ret = security_ops->file_permission(file, mask);
 	if (ret)
 		return ret;
@@ -879,6 +893,10 @@ int security_kernel_module_from_file(struct file *file)
 int security_task_fix_setuid(struct cred *new, const struct cred *old,
